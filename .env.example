# Copia este ficheiro para .env e preenche. O .env nunca deve ir para o Git.

# Palavra-passe para entrar na página (obrigatória se a app estiver na internet)
APP_PASSWORD=muda-isto

# Chave para as sessões: uma frase longa e aleatória (ex.: gera com  python3 -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Põe 1 quando a app estiver atrás de HTTPS
COOKIE_SEGURO=0

# --- Deye Cloud (developer.deyecloud.com → cria uma aplicação) ---
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
# Só se a conta não for europeia (ex.: https://us1-developer.deyecloud.com/v1.0)
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
# Só se tiveres mais do que uma instalação
DEYE_STATION_ID=

# Hora da sincronização diária
SYNC_HOUR=6

# Só na Vercel: segredo do cron job diário
CRON_SECRET=
# Só na Vercel (o Neon cria-a sozinho): ligação ao Postgres
DATABASE_URL=
